<Window x:Class="Snapture.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="#01000000"
        Topmost="True"
        Focusable="True"
        Cursor="Cross"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <!-- Flat white-on-red icon button for the selection mini-toolbar. -->
        <Style x:Key="RedToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="9,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Canvas x:Name="RootCanvas" ClipToBounds="True">
        <!-- The dim is rendered by a separate GPU-composited DimWindow behind this
             one; this window stays a lightweight input + chrome layer. -->

        <!-- Ruler guide lines + labels (drawn in code when toggled on). -->
        <Canvas x:Name="RulerLayer" IsHitTestVisible="False" />

        <!-- Selection outline -->
        <Rectangle x:Name="SelectionBorder"
                   Stroke="#F04747" StrokeThickness="1.5"
                   Visibility="Collapsed" />

        <!-- Preview of a crop-to result while hovering a picker option. -->
        <Rectangle x:Name="CropPreview" Stroke="#FFD54F" StrokeThickness="1.5"
                   StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Size badge -->
        <Border x:Name="InfoBadge" Background="#CC000000" CornerRadius="4"
                Padding="8,4" Visibility="Collapsed">
            <TextBlock x:Name="InfoText" Foreground="White" FontSize="12"
                       FontFamily="Consolas" />
        </Border>

        <!-- First-run hint -->
        <Border x:Name="HintBadge" Background="#CC000000" CornerRadius="6" Padding="14,10">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13"
                       TextAlignment="Center"
                       Text="Hover to snap to a UI area  •  Scroll for its parent  •  Click to lock it in  •  Drag for a custom area  •  Enter to record  •  Esc to cancel" />
        </Border>

        <!-- Selection mini-toolbar (red): crop-to-display/window, aspect lock, ruler.
             Placed near the selection (or docked to the main bar) in code. -->
        <Border x:Name="SelectionToolbar" CornerRadius="8" Padding="4" Visibility="Collapsed"
                Background="#F0C0392B" BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel x:Name="SelectionToolStack" Orientation="Horizontal">
                <Button x:Name="CropDisplayBtn" Style="{StaticResource RedToolButton}" Content="&#xE7F4;" ToolTip="Crop to display" />
                <Button x:Name="CropWindowBtn" Style="{StaticResource RedToolButton}" Content="&#xE737;" ToolTip="Crop to window" />
                <Button x:Name="AspectBtn" Style="{StaticResource RedToolButton}" Content="&#xE785;" ToolTip="Keep aspect ratio" />
                <Button x:Name="RulerBtn" Style="{StaticResource RedToolButton}" ToolTip="Ruler"
                        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FontWeight="SemiBold" Content="px" />
            </StackPanel>
        </Border>

        <!-- Popup list to choose among several overlapping displays/windows. -->
        <Border x:Name="CropPicker" CornerRadius="6" Padding="4" Visibility="Collapsed"
                Background="#F02B2B2B" BorderBrush="#40FFFFFF" BorderThickness="1">
            <StackPanel x:Name="CropPickerList" Orientation="Vertical" />
        </Border>

        <!-- Operable toolbar (rendered last → always above the dim).
             Opaque background and SizeAll cursor so it reads as draggable; drag
             it by any empty area to move it out of the way. -->
        <Border x:Name="Toolbar" CornerRadius="10" Padding="10,8"
                Background="#FF2B2B2B" Cursor="SizeAll"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <StackPanel x:Name="ToolbarStack" Orientation="Horizontal">
                <!-- Drag handle: reorder dots (the whole bar is draggable; this is the affordance). -->
                <UniformGrid x:Name="DragHandle" Columns="2" Rows="3" Width="9" Height="14" VerticalAlignment="Center"
                             Margin="2,0,12,0" Cursor="SizeAll" ToolTip="Drag to move"
                             TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </UniformGrid>

                <!-- Lead with the capture kind: still snapshot vs video (icons only). -->
                <Border x:Name="KindContainer" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                    <UniformGrid x:Name="KindGrid" Rows="1" Columns="2">
                        <RadioButton x:Name="KindSnapshot" Style="{StaticResource SegmentRadioButton}"
                                     GroupName="OverlayKind" MinWidth="46" ToolTip="Snapshot (still image)"
                                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Content="&#xE722;" />
                        <RadioButton x:Name="KindVideo" Style="{StaticResource SegmentRadioButton}"
                                     GroupName="OverlayKind" MinWidth="46" ToolTip="Video recording"
                                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Content="&#xE714;" />
                    </UniformGrid>
                </Border>

                <Border x:Name="ModeContainer" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <UniformGrid x:Name="ModeGrid" Rows="1" Columns="3">
                        <RadioButton x:Name="ModeDisplay" Style="{StaticResource SegmentRadioButton}"
                                     GroupName="OverlayMode" MinWidth="78" ToolTip="Display">
                            <Grid>
                                <TextBlock x:Name="ModeDisplayIcon" Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="17" HorizontalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="ModeDisplayText" Text="Display" HorizontalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ModeWindow" Style="{StaticResource SegmentRadioButton}"
                                     GroupName="OverlayMode" MinWidth="78" ToolTip="Window">
                            <Grid>
                                <TextBlock x:Name="ModeWindowIcon" Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="17" HorizontalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="ModeWindowText" Text="Window" HorizontalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ModeCustom" Style="{StaticResource SegmentRadioButton}"
                                     GroupName="OverlayMode" MinWidth="78" ToolTip="Custom">
                            <Grid>
                                <TextBlock x:Name="ModeCustomIcon" Text="&#xE7A8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="17" HorizontalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="ModeCustomText" Text="Custom" HorizontalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- Icon-only red action button; content + tooltip set per kind in code. -->
                <Button x:Name="RecordButton" Style="{StaticResource RecordButton}"
                        Margin="12,0,0,0" Padding="12,8" MinWidth="0" />
                <Button x:Name="CancelButton" Content="&#xE711;" ToolTip="Cancel (Esc)"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                        Margin="8,0,0,0" Padding="11,8" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
