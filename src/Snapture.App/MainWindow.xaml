<Window x:Class="Snapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture"
        Width="564" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <!-- One selectable cell of the toolbar-position grid. When picked it gets an
             accent border and reveals a little bar showing where the toolbar sits. -->
        <Style x:Key="PositionCell" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cell" CornerRadius="3" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter x:Name="cp" Opacity="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="cp" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="cp" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border Margin="12" CornerRadius="10" Background="#FF1F1F1F"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag surface) -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,18" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="22" Height="22" Stroke="{StaticResource RecordAccentBrush}"
                             StrokeThickness="3" VerticalAlignment="Center" />
                    <TextBlock Text="Snapture" FontSize="22" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ReleaseNotesButton" Style="{StaticResource IconButton}"
                            Content="&#xE8A5;" ToolTip="View release notes" />
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource IconButton}"
                            Content="&#xE72C;" ToolTip="Check for updates" />
                    <Button x:Name="UpdateBellButton" Style="{StaticResource AccentIconButton}" Visibility="Collapsed">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Path Fill="White"
                                  Data="M12 22 C13.1 22 14 21.1 14 20 H10 C10 21.1 10.9 22 12 22 Z M18 16 v-5 C18 7.93 16.37 5.36 13.5 4.68 V4 C13.5 3.17 12.83 2.5 12 2.5 C11.17 2.5 10.5 3.17 10.5 4 v.68 C7.63 5.36 6 7.93 6 11 v5 l-2 2 v1 h16 v-1 l-2-2 Z" />
                        </Viewbox>
                    </Button>
                    <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Name="CloseXButton" Style="{StaticResource IconButton}"
                            Content="&#xE8BB;" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <Border Grid.Row="1" Style="{StaticResource SegmentedContainer}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <UniformGrid Rows="1" Columns="4">
                    <RadioButton x:Name="TabGeneral" Style="{StaticResource SegmentRadioButton}" GroupName="SettingsTab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="General" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSnapshot" Style="{StaticResource SegmentRadioButton}" GroupName="SettingsTab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Snapshot" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabVideo" Style="{StaticResource SegmentRadioButton}" GroupName="SettingsTab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Snapture" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabPicker" Style="{StaticResource SegmentRadioButton}" GroupName="SettingsTab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Picker" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <!-- Tab content -->
            <Grid Grid.Row="2">

                <!-- ===== General ===== -->
                <StackPanel x:Name="GeneralPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default snap mode" Style="{StaticResource SettingLabel}" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SegmentedContainer}" Margin="0,8" HorizontalAlignment="Left">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="DefLastUsed" Style="{StaticResource SegmentRadioButton}" GroupName="DefKind" Content="Last used" MinWidth="84" />
                                <RadioButton x:Name="DefSnapshot" Style="{StaticResource SegmentRadioButton}" GroupName="DefKind" Content="Snapshot" MinWidth="84" />
                                <RadioButton x:Name="DefVideo" Style="{StaticResource SegmentRadioButton}" GroupName="DefKind" Content="Snapture" MinWidth="84" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Global shortcuts" VerticalAlignment="Top" Margin="0,12" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
                            <CheckBox x:Name="HotkeysMasterSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="PickerHotkeySwitch" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open picker" VerticalAlignment="Center" Margin="12,6,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="PickerHotkeyText" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Row="0" Grid.Column="3" x:Name="PickerHotkeyChange" Content="Change" Padding="10,4" />
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="SnapHotkeySwitch" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Snapshot" VerticalAlignment="Center" Margin="12,14,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SnapHotkeyText" VerticalAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Row="1" Grid.Column="3" x:Name="SnapHotkeyChange" Content="Change" Padding="10,4" Margin="0,8,0,0" />
                                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="RecHotkeySwitch" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Record" VerticalAlignment="Center" Margin="12,14,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="RecHotkeyText" VerticalAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Row="2" Grid.Column="3" x:Name="RecHotkeyChange" Content="Change" Padding="10,4" Margin="0,8,0,0" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stream Deck server" VerticalAlignment="Center" Margin="0,12" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8" HorizontalAlignment="Left">
                            <CheckBox x:Name="ServerCheck" Content="Enable on port" VerticalAlignment="Center" />
                            <TextBox x:Name="PortBox" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Button x:Name="PluginStatusButton" Style="{StaticResource IconButton}" Margin="12,0,0,0"
                                    VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="PluginGitHubButton" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="Open the Stream Deck plugin on GitHub">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                          Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="FfmpegStatus" Margin="0,14,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Cursor="Hand" ToolTipService.InitialShowDelay="200"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- ===== Snapshot ===== -->
                <Grid x:Name="SnapshotPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output format" Style="{StaticResource SettingLabel}" />
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SegmentedContainer}" Margin="0,8" HorizontalAlignment="Left">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="SnapFormatPng" Style="{StaticResource SegmentRadioButton}" GroupName="SnapFormat" Content="PNG" MinWidth="76" />
                            <RadioButton x:Name="SnapFormatJpeg" Style="{StaticResource SegmentRadioButton}" GroupName="SnapFormat" Content="JPEG" MinWidth="76" />
                            <RadioButton x:Name="SnapFormatWebp" Style="{StaticResource SegmentRadioButton}" GroupName="SnapFormat" Content="WebP" MinWidth="76" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Default capture mode" Style="{StaticResource SettingLabel}" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentedContainer}" Margin="0,8" HorizontalAlignment="Left">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="SnapModeDisplay" Style="{StaticResource SegmentRadioButton}" GroupName="SnapMode" Content="Display" MinWidth="84" />
                            <RadioButton x:Name="SnapModeWindow" Style="{StaticResource SegmentRadioButton}" GroupName="SnapMode" Content="Window" MinWidth="84" />
                            <RadioButton x:Name="SnapModeCustom" Style="{StaticResource SegmentRadioButton}" GroupName="SnapMode" Content="Custom" MinWidth="84" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Capture mouse cursor" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="SnapCursorSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Send to clipboard" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="SnapClipboardSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Library folder" VerticalAlignment="Top" Margin="0,12" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8" HorizontalAlignment="Left">
                        <TextBlock x:Name="SnapLibraryPathText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="320" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SnapOpenLibrary" Content="Open" />
                            <Button x:Name="SnapChangeLibrary" Content="Change…" Margin="8,0,0,0" />
                            <Button x:Name="SnapResetLibrary" Content="Use default" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Snapture (video) ===== -->
                <Grid x:Name="VideoPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output format" Style="{StaticResource SettingLabel}" />
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SegmentedContainer}" Margin="0,8" HorizontalAlignment="Left">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="VidFormatMp4" Style="{StaticResource SegmentRadioButton}" GroupName="VidFormat" Content="MP4" MinWidth="76" />
                            <RadioButton x:Name="VidFormatWebp" Style="{StaticResource SegmentRadioButton}" GroupName="VidFormat" Content="WebP" MinWidth="76" />
                            <RadioButton x:Name="VidFormatGif" Style="{StaticResource SegmentRadioButton}" GroupName="VidFormat" Content="GIF" MinWidth="76" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Default capture mode" Style="{StaticResource SettingLabel}" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentedContainer}" Margin="0,8" HorizontalAlignment="Left">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="VidModeDisplay" Style="{StaticResource SegmentRadioButton}" GroupName="VidMode" Content="Display" MinWidth="84" />
                            <RadioButton x:Name="VidModeWindow" Style="{StaticResource SegmentRadioButton}" GroupName="VidMode" Content="Window" MinWidth="84" />
                            <RadioButton x:Name="VidModeCustom" Style="{StaticResource SegmentRadioButton}" GroupName="VidMode" Content="Custom" MinWidth="84" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame rate" Style="{StaticResource SettingLabel}" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FpsSlider" Grid.Column="0" Minimum="5" Maximum="60"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="FpsValue" Grid.Column="1" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quality" Style="{StaticResource SettingLabel}" />
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="QualitySlider" Grid.Column="0" Minimum="0" Maximum="100"
                                TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="QualityValue" Grid.Column="1" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture mouse cursor" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="VidCursorSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Send to clipboard" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="VidClipboardSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,8" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Library folder" VerticalAlignment="Top" Margin="0,12" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,8" HorizontalAlignment="Left">
                        <TextBlock x:Name="VidLibraryPathText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="320" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="VidOpenLibrary" Content="Open" />
                            <Button x:Name="VidChangeLibrary" Content="Change…" Margin="8,0,0,0" />
                            <Button x:Name="VidResetLibrary" Content="Use default" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Picker ===== -->
                <StackPanel x:Name="PickerPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Toolbar position" VerticalAlignment="Top" Margin="0,10" />
                        <StackPanel Grid.Column="1" Margin="0,8">
                            <!-- The 'screen', partitioned into 9 cells. Pick a cell (not the
                                 centre); the little bar inside shows where the toolbar sits. -->
                            <Border Width="214" Height="136" CornerRadius="8" HorizontalAlignment="Left"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="2">
                                <Grid>
                                    <Path Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                                          StrokeDashArray="3 2" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                          Data="M70,0 L70,132 M140,0 L140,132 M0,44 L210,44 M0,88 L210,88" />
                                    <UniformGrid Rows="3" Columns="3">
                                        <RadioButton x:Name="PosTopLeft" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Top-left corner">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosTopCenter" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Top edge">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosTopRight" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Top-right corner">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosLeftCenter" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Left edge (vertical bar)">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="9" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </RadioButton>
                                        <!-- centre: not selectable -->
                                        <Border />
                                        <RadioButton x:Name="PosRightCenter" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Right edge (vertical bar)">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="9" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosBottomLeft" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Bottom-left corner">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosBottomCenter" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Bottom edge">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                        </RadioButton>
                                        <RadioButton x:Name="PosBottomRight" Style="{StaticResource PositionCell}" GroupName="PickerPos" ToolTip="Bottom-right corner">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" Width="22" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </RadioButton>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            <TextBlock Text="Left/right edges render the bar vertically." FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Selection toolbar position" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left">
                                <UniformGrid Rows="1" Columns="5" TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="16">
                                    <RadioButton x:Name="SelPosLeft" Style="{StaticResource SegmentRadioButton}" GroupName="SelPos" Content="&#xE76B;" MinWidth="48" ToolTip="Left edge" />
                                    <RadioButton x:Name="SelPosRight" Style="{StaticResource SegmentRadioButton}" GroupName="SelPos" Content="&#xE76C;" MinWidth="48" ToolTip="Right edge" />
                                    <RadioButton x:Name="SelPosTop" Style="{StaticResource SegmentRadioButton}" GroupName="SelPos" Content="&#xE70E;" MinWidth="48" ToolTip="Top edge" />
                                    <RadioButton x:Name="SelPosBottom" Style="{StaticResource SegmentRadioButton}" GroupName="SelPos" Content="&#xE70D;" MinWidth="48" ToolTip="Bottom edge" />
                                    <RadioButton x:Name="SelPosDock" Style="{StaticResource SegmentRadioButton}" GroupName="SelPos" Content="&#xE718;" MinWidth="48" ToolTip="Dock to main toolbar" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Margin="0,16,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keyboard shortcuts" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="ViewShortcutsButton" Content="View shortcuts…" Padding="12,6" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Permanent footer -->
            <StackPanel Grid.Row="3">
                <Border Height="1" Margin="0,20,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="GitHubButton" Style="{StaticResource IconButton}" ToolTip="Open the Snapture GitHub page">
                            <Viewbox Width="18" Height="18">
                                <Path Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                      Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="QuitButton" Content="Quit" Margin="8,0,0,0" Padding="16,8"
                                ToolTip="Quit Snapture completely — stops recording/hotkeys and removes the tray icon" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="FooterSnapshotButton" Style="{StaticResource FooterCaptureButton}" ToolTip="Take a snapshot" />
                        <Button x:Name="FooterRecordButton" Style="{StaticResource FooterCaptureButton}" Margin="10,0,0,0" ToolTip="Start recording" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    <!-- Attention flash when the settings window is re-invoked while already open. -->
    <Border x:Name="FlashOverlay" Margin="12" CornerRadius="10"
            Background="{StaticResource RecordAccentBrush}" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
